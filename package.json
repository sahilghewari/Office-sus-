{
  "name": "corporate-sus",
  "private": true,
  "version": "1.0.0",
  "description": "Corporate Sus — a 2.5D isometric multiplayer social-deduction game. Trust nobody. Especially management.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @corp/server",
    "dev:web": "npm run dev -w @corp/web",
    "build": "npm run build -w @corp/server && npm run build -w @corp/web",
    "start": "npm run start -w @corp/server",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server && tsc -p apps/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate -w @corp/server",
    "db:deploy": "npm run db:deploy -w @corp/server",
    "loadtest": "tsx tests/load/loadtest.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
