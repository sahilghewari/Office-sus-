# ─────────────────────────────────────────────────────────────
# Corporate Sus — example configuration. Copy to `.env`.
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Server
PORT=2567
HOST=0.0.0.0
NODE_ENV=development
# Public URL of the web client (used for CORS + invite links)
PUBLIC_ORIGIN=http://localhost:5173
# REQUIRED in production: long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string

# PostgreSQL (optional in development: without it accounts/stats use an in-memory store)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/corporate_sus

# Redis (optional: enables cross-instance room directory + matchmaking)
# REDIS_URL=redis://localhost:6379
# Public base URL clients should use to reach THIS instance (multi-instance setups)
# INSTANCE_URL=wss://game-1.example.com

# LiveKit voice (optional: the game works without voice)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Serve the built web client from the game server (single-container deploys)
# SERVE_WEB=true

# Test-only hooks (forced roles, teleport). NEVER enable in production.
# ENABLE_TEST_HOOKS=false
