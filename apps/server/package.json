    "@prisma/client": "^6.19.0",
    "fastify": "^5.6.0",
    "ioredis": "^5.8.0",
    "livekit-server-sdk": "^2.13.0",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.10",
    "prisma": "^6.19.0"
  }
}
